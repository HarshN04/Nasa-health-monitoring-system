/* =========================================================
   home.css — styles used only on the Home page.
   Shared colours and components live in global.css.
   ========================================================= */

/* Tiles are links: remove default link styling */
.tiles .tile {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  text-decoration: none;
  color: inherit;
  min-height: 140px;
}
.tile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}
.tile-reason { margin-top: 0; }
.tile-detail { font-size: var(--fs-xs); color: var(--text-muted); margin-top: auto; }
.tiles .progress { margin-top: var(--space-1); }

/* Sidebar switch button */
.switch-crew { margin-top: var(--space-2); padding-left: 0; }

/* Space weather alert layout */
#space-weather-alert { align-items: center; }
.alert-icon { font-size: var(--fs-xl); line-height: 1; }
.alert-body { flex: 1; }
.shelter-status { margin-top: var(--space-1); font-weight: 600; }

/* Status bar colour follows the overall state (set by home.js) */
.status-bar.is-watch  { background: var(--watch-soft);  border-color: var(--watch);  color: var(--watch); }
.status-bar.is-danger { background: var(--danger-soft); border-color: var(--danger); color: var(--danger); }

/* Suggested actions and Due today lists */
.action-list,
.due-list {
  list-style: none;
  margin: 0 0 var(--space-4);
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.action-list li,
.due-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  background: var(--surface-muted);
  border-radius: var(--radius-sm);
  border-left: 4px solid transparent;
}
.action-list li.level-watch  { border-left-color: var(--watch); }
.action-list li.level-danger { border-left-color: var(--danger); background: var(--danger-soft); }
.action-list li.is-done span { text-decoration: line-through; color: var(--text-muted); }
.empty-note { color: var(--text-muted); font-size: var(--fs-sm); }

/* Cabin readings outside limits */
.cabin-watch  { color: var(--watch);  font-weight: 700; }
.cabin-danger { color: var(--danger); font-weight: 700; }

/* Small button size (move to global.css once another page needs it) */
.btn-sm { padding: 6px 12px; font-size: var(--fs-xs); }

/* Demo bar */
.demo-bar {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-5);
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

/* Emergency dialog */
.dialog {
  border: none;
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  max-width: 420px;
  box-shadow: var(--shadow-lg);
  color: var(--text);
}
.dialog::backdrop { background: rgba(18, 38, 58, 0.45); }
.dialog h2 { color: var(--danger); }
.dialog-actions { justify-content: flex-end; margin-top: var(--space-4); }